{
  "author": "Hajer Karoui, Niall Bourke",
  "cite": "recon-any: This tool is a deep learning-enabled version of 'Recon-all-like' stream that can handle any adult 3D imaging volumes of arbitrary orientation/resolution/contrast (including low-fied/portable MRI scans and 3D reconstructions of dissection photographs). https://surfer.nmr.mgh.harvard.edu/fswiki/ReconAny",
  "command": "bash /flywheel/v0/start.sh",
  "config": {},
  "custom": {
    "analysis-level": "participant",
    "flywheel": {
      "classification": {
        "components": [
          "FreeSurfer"
        ],
        "keywords": [
          "segmentation",
          "volume",
          "template"
        ],
        "modality": [
          "MR"
        ],
        "type": [
          "nifti"
        ]
      },
      "suite": "UNITY Apps"
    },
    "gear-builder": {
      "category": "analysis",
      "image": "flywheel/recon-any:0.4.8"
    },
    "kcl-app-binary": "app/main.sh",
    "kcl-app-modalities": [
      "anat"
    ],
    "license": {
      "dependencies": [
        {
          "name": "Other",
          "url": "/usr/local/freesurfer/license.txt"
        }
      ],
      "main": {
        "name": "",
        "url": ""
      },
      "non-commercial-use-only": false
    }
  },
  "description": "This gear implements out-of-the-box SynthSR & SynthSeg, the first convolutional neural network for segmentation of brain MRI scans of any contrast and resolution",
  "environment": {
    "CONDA_DIR": "/opt/conda",
    "FLYWHEEL": "/flywheel/v0",
    "FMRI_ANALYSIS_DIR": "/usr/local/freesurfer/fsfast",
    "FREESURFER": "/usr/local/freesurfer",
    "FREESURFER_HOME": "/usr/local/freesurfer",
    "FSFAST_HOME": "/usr/local/freesurfer/fsfast",
    "FSF_OUTPUT_FORMAT": "nii.gz",
    "FSLDIR": "/opt/conda",
    "FS_LICENSE": "/usr/local/freesurfer/.license",
    "FS_OVERRIDE": "0",
    "FUNCTIONALS_DIR": "/usr/local/freesurfer/sessions",
    "GPG_KEY": "A035C8C19219BA821ECEA86B64E628F8D684696D",
    "LANG": "C.UTF-8",
    "LOCAL_DIR": "/usr/local/freesurfer/local",
    "MINC_BIN_DIR": "/usr/local/freesurfer/mni/bin",
    "MINC_LIB_DIR": "/usr/local/freesurfer/mni/lib",
    "MNI_DATAPATH": "/usr/local/freesurfer/mni/data",
    "MNI_DIR": "/usr/local/freesurfer/mni",
    "MNI_PERL5LIB": "/usr/local/freesurfer/mni/share/perl5",
    "OS": "Linux",
    "PATH": "/usr/local/freesurfer/bin:/usr/local/freesurfer/fsfast/bin:/usr/local/freesurfer/tktools:/usr/local/freesurfer/mni/bin:/usr/local/bin:/usr/bin:/bin",
    "PERL5LIB": "/usr/local/freesurfer/mni/share/perl5",
    "PWD": "/flywheel/v0",
    "PYTHONPATH": "/flywheel/v0:",
    "PYTHON_GET_PIP_SHA256": "fa6f3fb93cce234cd4e8dd2beb54a51ab9c247653b52855a48dd44e6b21ff28b",
    "PYTHON_GET_PIP_URL": "https://github.com/pypa/get-pip/raw/c20b0cfd643cd4a19246ccf204e2997af70f6b21/public/get-pip.py",
    "PYTHON_PIP_VERSION": "21.2.3",
    "PYTHON_SHA256": "de6517421601e39a9a3bc3e1bc4c7b2f239297423ee05e282598c83ec0647505",
    "PYTHON_VERSION": "3.10.20",
    "SHLVL": "0",
    "SUBJECTS_DIR": "/usr/local/freesurfer/subjects",
    "_": "/usr/bin/printenv",
    "container": "oci"
  },
  "inputs": {
    "api-key": {
      "base": "api-key",
      "read-only": true
    },
    "input": {
      "base": "file",
      "description": "input file",
      "optional": false
    }
  },
  "label": "recon-any",
